# URL do projeto Supabase e chave PUBLICÁVEL (não use service_role nem sb_secret).
# Variáveis VITE_ são embutidas no código enviado ao navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcional: e-mail público, confirmado pelo responsável, para solicitações de privacidade.
VITE_PRIVACY_CONTACT_EMAIL=
# Opcional: domínios autorizados a medir audiência (separados por vírgula).
# Vazio permite qualquer domínio de produção; desenvolvimento e prévias nunca contam.
VITE_ANALYTICS_HOSTS=
